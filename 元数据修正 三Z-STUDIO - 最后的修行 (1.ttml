<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="zh-Hans" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="musicName" value="最后的修行"/><amll:meta key="musicName" value="最後的修行"/><amll:meta key="artists" value="三Z-STUDIO"/><amll:meta key="artists" value="HOYO-MiX"/><amll:meta key="artists" value="狐妖Mikan"/><amll:meta key="album" value="绝区零-极限委托：PV原声集"/><amll:meta key="album" value="极限委托：PV原声集 (游戏《绝区零》原声集)"/><amll:meta key="album" value="極限委託:PV原聲集 (遊戲《絕區零》原聲集)"/><amll:meta key="ttmlAuthorGithub" value="176977142"/><amll:meta key="ttmlAuthorGithubLogin" value="Nick"/><amll:meta key="isrc" value="DGA0T2460585"/><amll:meta key="qqMusicId" value="554043116"/><amll:meta key="qqMusicId" value="001DAiDu2BbXNc"/><amll:meta key="spotifyId" value="44w6q4W7PJkEaoXdeojNYf"/><amll:meta key="appleMusicId" value="1788293966"/><amll:meta key="ncmMusicId" value="2663827234"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Kanato Tanihata</songwriter></songwriters><translations><translation xml:lang="zh-Hans" type="subtitle"><text for="L1">在摇曳阴影的深处</text><text for="L2">封存着 隐隐作痛的记忆气息</text><text for="L3">未及出口的话语 字字如刀锋般犀利</text><text for="L4">即便如此 此刻仍报以微笑</text><text for="L5">只因那抹淡红 已灼伤眼眸</text><text for="L6">拂晓时分 依旧在无路的朦胧中前行</text><text for="L7">世界与我 这破碎的故事</text><text for="L8">从今往后 必须携手 重新书写</text><text for="L9">只因那抹淡红 已灼伤眼眸</text><text for="L10">拂晓时分 依旧在无路的朦胧中前行</text><text for="L11">世界与我 这破碎的故事，从今往后...</text></translation></translations><transliterations><transliteration xml:lang="ja-Latn"><text for="L1">tanabiku kage no oku ni wa</text><text for="L2">tojikome ta   itamu kioku no nioi</text><text for="L3">nugue nai kotoba ni   saya mo yaka re ta</text><text for="L4">shika ri keredo   ima wa tada   hohoen de</text><text for="L5">asa hi no iro wa mō   me ga kuramu kara</text><text for="L6">akegata ni wa   michi no mie nai mama aruku</text><text for="L7">sekai to watashi   koware ta hanashi   korekara wa</text><text for="L8">kakikae atte   ika nakya   Ah</text><text for="L9">asa hi no iro wa mō   me ga kuramu kara</text><text for="L10">akegata ni wa   michi no mie nai mama aruku</text><text for="L11">sekai to watashi   koware ta hanashi   korekara wa</text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="02:13.090"><div begin="00:14.690" end="02:13.090"><p begin="00:14.690" end="00:19.556" ttm:agent="v1" itunes:key="L1"><span begin="00:14.690" end="00:14.954">た</span><span begin="00:14.954" end="00:15.413">な</span><span begin="00:15.413" end="00:15.659">び</span><span begin="00:15.659" end="00:16.190">く</span><span begin="00:16.682" end="00:17.483">影</span><span begin="00:17.483" end="00:18.074">の</span><span begin="00:18.074" end="00:18.798">奥</span><span begin="00:18.798" end="00:19.229">に</span><span begin="00:19.229" end="00:19.556">は</span></p><p begin="00:20.045" end="00:26.340" ttm:agent="v1" itunes:key="L2"><span begin="00:20.045" end="00:20.256">閉</span><span begin="00:20.256" end="00:20.717">じ</span><span begin="00:20.717" end="00:20.892">込</span><span begin="00:20.892" end="00:21.135">め</span><span begin="00:21.135" end="00:21.425">た</span> <span begin="00:22.181" end="00:22.478">傷</span><span begin="00:22.478" end="00:22.955">む</span><span begin="00:22.955" end="00:23.216">記</span><span begin="00:23.216" end="00:24.262">憶</span><span begin="00:24.262" end="00:24.964">の</span><span begin="00:24.964" end="00:25.915">匂</span><span begin="00:25.915" end="00:26.340">い</span></p><p begin="00:27.166" end="00:32.909" ttm:agent="v1" itunes:key="L3"><span begin="00:27.166" end="00:27.562">拭</span><span begin="00:27.562" end="00:27.809">え</span><span begin="00:27.809" end="00:27.991">な</span><span begin="00:27.991" end="00:28.222">い</span><s