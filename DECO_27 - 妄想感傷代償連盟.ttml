<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:lang="ja" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">初音未来</ttm:name></ttm:agent><amll:meta key="ttmlAuthorGithub" value="176977142"/><amll:meta key="ttmlAuthorGithubLogin" value="zhr166"/><amll:meta key="ttmlAuthorLyricify" value="悲杏"/><amll:meta key="deliverableAudioLanguage" value="ja"/><amll:meta key="album" value="GHOST"/><amll:meta key="artists" value="DECO*27"/><amll:meta key="artists" value="初音未来"/><amll:meta key="artists" value="Hatsune Miku"/><amll:meta key="appleMusicId" value="1147145184"/><amll:meta key="isrc" value="JPJ931600133"/><amll:meta key="spotifyId" value="1fEooTowVu4xNFGoXKxWvR"/><amll:meta key="ncmMusicId" value="432486474"/><amll:meta key="qqMusicId" value="240192926"/><amll:meta key="qqMusicId" value="0002zZ8D4XwedV"/><amll:meta key="musicName" value="妄想感傷代償連盟"/><amll:meta key="musicName" value="Dscf"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>DECO*27</songwriter></songwriters><translations><translation xml:lang="zh-CN" type="subtitle"><text for="L1">惨了 不小心吐露心声了</text><text for="L2">求你 再在身边陪我一会儿好不好</text><text for="L3">啊 开什么玩笑 死缠烂打也太恶心了吧</text><text for="L4">对不起啦 你赶紧滚回家吧</text><text for="L5">这屋里全是你呼出的废气 那是你的浓度</text><text for="L6">好想就这样烂死在这个浑浊不堪的烂泥梦里</text><text for="L7">就算被骂死任性 我也要吐出舌头对你作怪</text><text for="L8">我才没有不安呢 反正我们根本没有未来</text><text for="L9">真想把我这身皮剥了 整容成你的这张脸啊</text><text for="L10">我可算彻底看透了</text><text for="L11">就算把对你的恨之入骨翻个面</text><text for="L12">底下也根本没有藏着一丝一毫的爱意</text><text for="L13">好想实现这份沉重的心意</text><text for="L14">对你撒娇太甚 这颗心已经肿胀肥胖得不成样子</text><text for="L15">干脆立个口号 把这病态膨胀的爱 抽脂抽到干瘪吧</text><text for="L16">让我们变回刚认识时那样装模作样吧</text><text for="L17">露出狰狞自嘲的笑 勾勒着癫狂的幻想</text><text for="L18">杀红了眼的执念 最终竟化作了病态的安宁</text><text for="L19">可是啊 万事大吉的恋爱在这个破世界上根本就不存在</text><text for="L20">所以只能靠着狂乱的妄想 自残般的感伤 惨痛的代价与苟合</text><text for="L21">死死怀抱爱情 歇斯底里地高喊虚无的理想</text><text for="L22">这是穷途末路的蠢货唱出的破败旋律</text><text for="L23">重新来过 转世投胎 空间跃迁</text><text for="L24">无论多少次 都要这样层层重叠着 一步步走向毁灭</text><text for="L25">来吧 任凭这永无止境的畸爱把我吞噬</text><text for="L26">究竟是爱还是讨厌到恶心</text><text for="L27">究竟是爱还是讨厌到恶心</text><text for="L28">究竟是爱还是讨厌到恶心</text><text for="L29">究竟是爱还是讨厌到恶心</text><text for="L30">我已经拼尽全力去讨好你了啊</text><text for="L31">是你那没救了的自私与任性</text><text for="L32">在我全部顺从之后 我却成了困在迷局里抓狂的自恋狂</text><text for="L33">你生气了吗 我没生气哦</text><text for="L34">明明该心照不宣 节拍却偏偏错乱得一塌糊涂</text><text for="L35">这要是一部烂俗的电影或电视剧</text><text for="L36">虽然我能咬烂牙关硬撑到片尾字幕滚完</text><text for="L37">但我这辈子都绝不想再看第二遍</text><text for="L38">无论是开端 发展 转折还是结局 全都烂透了</text><text for="L39">可我这个蠢货 居然偏偏去相信了没关系这种屁话啊</text><text for="L40">所谓名义上的 爱情 对象 年龄</text><text for="L41">因为憎恨爱而强行维持的虚伪平衡</text><text for="L42">终于如期顺理成章地开始扭曲崩塌了</text><text for="L43">真是烂透了 反正我也只是你人际交往里的润滑剂罢了</text><text for="L44">那就来啊 无论多少次 我们都要互相残杀 互相折磨</text><text for="L45">去碰撞 去融合我们这烂透了的爱之哲学</text><text for="L46">可我偏偏学会了我没事这种可笑的谎言啊</text><text for="L47">所以</text><text for="L48">所以只能靠着狂乱的妄想 自残般的感伤 惨痛的代价与苟合</text><text for="L49">死死怀抱爱情 歇斯底里地高喊虚无的理想</text><text for="L50">这是穷途末路的蠢货唱出的破败旋律</text><text for="L51">重新来过 转世投胎 空间跃迁</text><text for="L52">无论多少次 都要这样层层重叠着 一步步走向毁灭</text><text for="L53">来吧 任凭这永无止境的畸爱把我吞噬</text><text for="L54">所谓名义上的 爱情 对象 年龄</text><text for="L55">因为憎恨爱而强行维持的虚伪平衡</text><text for="L56">终于如期顺理成章地开始扭曲崩塌了</text><text for="L57">真是烂透了 反正我也只是你人际交往里的润滑剂罢了</text><text for="L58">那就来啊 无论多少次 我们都要互相残杀 互相折磨</text><text for="L59">来吧 去碰撞 去融合我们这烂透了的爱之哲学</text><text for="L60">究竟是爱还是讨厌到恶心</text><text for="L61">究竟是爱还是讨厌到恶心</text><text for="L62">究竟是爱还是讨厌到恶心</text><text for="L63">究竟是爱还是讨厌到恶心</text><text for="L64">究竟是爱还是讨厌到恶心</text><text for="L65">究竟是爱还是讨厌到恶心</text><text for="L66">究竟是爱还是讨厌到恶心</text><text for="L67">究竟是爱还是讨厌到恶心</text><text for="L68">究竟是爱还是讨厌到恶心</text><text for="L69">究竟是爱还是讨厌到恶心</text><text for="L70">究竟是爱还是讨厌到恶心</text></translation></translations><transliterations><transliteration xml:lang="ja-Latn"><text for="L1"><span xmlns="http://www.w3.org/ns/ttml" begin="00:08.107" end="00:08.323">i</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:08.323" end="00:08.622">chat</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:08.622" end="00:08.821">ta</span></text><text for="L2"><span xmlns="http://www.w3.org/ns/ttml" begin="00:08.863" end="00:09.019">mo</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:09.019" end="00:09.148">u</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:09.148" end="00:09.446">jo</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:09.446" end="00:09.596">to</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:09.596" end="00:09.740">da</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:09.740" end="00:09.886">ke</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:09.886" end="00:10.114">tona</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:10.114" end="00:10.262">ri</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:10.262" end="00:10.465">ni</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:10.465" end="00:10.546">i</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:10.546" end="00:10.651">ta</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:10.651" end="00:10.846">i</span></text><text for="L3"><span xmlns="http://www.w3.org/ns/ttml" begin="00:10.966" end="00:11.083">i</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:11.083" end="00:11.227">ya</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:11.227" end="00:11.328">i</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:11.328" end="00:11.484">ya</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:11.484" end="00:11.592">ma</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:11.592" end="00:11.712">sa</span><span xmlns="http://www.w3.org/ns/ttml" begin="00:11.712" end="00:11.88